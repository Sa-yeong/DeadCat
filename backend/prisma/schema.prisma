generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model affinity {
  user_id        BigInt
  stock_id       BigInt
  affinity_score Int      @default(0) @db.SmallInt
  is_hidden      Boolean?
  stocks         stocks   @relation(fields: [stock_id], references: [id], onUpdate: NoAction)
  users          users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, stock_id])
}

model categories {
  id     BigInt   @id @default(autoincrement())
  name   String   @db.VarChar(100)
  stocks stocks[]
}

model characters {
  stock_id    BigInt   @id
  img_url     String   @db.VarChar(200)
  personality String?  @db.VarChar(20)
  sensitivity Decimal? @db.Decimal(3, 2)
  stocks      stocks   @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model clothes {
  id               BigInt     @id @default(autoincrement())
  name             String     @unique @db.VarChar(100)
  stock_id         BigInt?
  unlock_affinity  Int?       @db.SmallInt
  unlock_rise_rate Decimal?   @db.Decimal(6, 2)
  wardrobe         wardrobe[]
}

model comments {
  id         BigInt   @id @default(autoincrement())
  post_id    BigInt
  user_id    BigInt
  content    String   @db.VarChar(150)
  write_time DateTime @default(now()) @db.Timestamp(6)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model furnitures {
  id               BigInt    @id @default(autoincrement())
  name             String    @unique @db.VarChar(100)
  stock_id         BigInt?
  unlock_affinity  Int?      @db.SmallInt
  unlock_rise_rate Decimal?  @db.Decimal(6, 2)
  placed           placed[]
  storage          storage[]
}

model holdings {
  user_id            BigInt
  stock_id           BigInt
  quantity           Int
  mean_price_krw     BigInt
  mean_price_foreign Decimal?  @db.Decimal(15, 2)
  created_at         DateTime? @db.Timestamp(6)
  is_placed          Boolean?
  x_position         Float?
  y_position         Float?
  stocks             stocks    @relation(fields: [stock_id], references: [id], onUpdate: NoAction)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, stock_id])
}

model indices {
  id              BigInt            @id @default(autoincrement())
  name            String            @db.VarChar(100)
  code            String            @unique @db.VarChar(20)
  name_en         String            @db.VarChar(100)
  indices_history indices_history[]
}

model indices_history {
  indices_id  BigInt
  open_price  Decimal  @db.Decimal(10, 2)
  close_price Decimal  @db.Decimal(10, 2)
  low_price   Decimal  @db.Decimal(10, 2)
  high_price  Decimal  @db.Decimal(10, 2)
  write_date  DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  indices     indices  @relation(fields: [indices_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([indices_id, write_date])
}

model interest {
  user_id     BigInt
  stock_id    BigInt
  select_time DateTime @default(now()) @db.Timestamp(6)
  stocks      stocks   @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, stock_id])
}

model inventory {
  user_id  BigInt
  item_id  BigInt
  quantity Int
  items    items  @relation(fields: [item_id], references: [id], onUpdate: NoAction)
  users    users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, item_id])
}

model items {
  id           BigInt      @id @default(autoincrement())
  name         String      @unique @db.VarChar(100)
  effect_value Int         @db.SmallInt
  inventory    inventory[]
}

model like_posts {
  user_id BigInt
  post_id BigInt
  posts   posts  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, post_id])
}

model placed {
  id           BigInt     @id @default(autoincrement())
  user_id      BigInt
  furniture_id BigInt
  position_x   Decimal    @db.Decimal(10, 5)
  position_y   Decimal    @db.Decimal(10, 5)
  furnitures   furnitures @relation(fields: [furniture_id], references: [id], onUpdate: NoAction)
  users        users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, furniture_id])
}

model posts {
  id                                BigInt       @id @default(autoincrement())
  writer_id                         BigInt?
  content                           String       @db.VarChar(500)
  write_time                        DateTime     @default(now()) @db.Timestamp(6)
  stock_id                          BigInt?
  type                              String       @default("COMMUNITY") @db.VarChar(20)
  target_user_id                    BigInt?
  title                             String?      @db.VarChar(200)
  comments                          comments[]
  like_posts                        like_posts[]
  stocks                            stocks?      @relation(fields: [stock_id], references: [id], onDelete: Cascade)
  users_posts_target_user_idTousers users?       @relation("posts_target_user_idTousers", fields: [target_user_id], references: [id], onDelete: Cascade)
  users_posts_writer_idTousers      users?       @relation("posts_writer_idTousers", fields: [writer_id], references: [id], onUpdate: NoAction, map: "posts_user_id_fkey")
  vote                              vote?
}

model stock_history {
  stock_id    BigInt
  record_date DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  open_price  BigInt
  close_price BigInt
  low_price   BigInt
  high_price  BigInt
  stocks      stocks   @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([stock_id, record_date])
}

model stocks {
  id                  BigInt                @id @default(autoincrement())
  code                String                @db.VarChar(20)
  exchange_code       String?               @db.VarChar(10)
  category_id         BigInt?
  stock_type          String                @db.VarChar(10)
  name                String                @db.VarChar(100)
  market_cap          BigInt
  per                 Decimal               @db.Decimal(10, 2)
  psr                 Decimal               @db.Decimal(10, 2)
  pbr                 Decimal               @db.Decimal(10, 2)
  eps                 Decimal               @db.Decimal(15, 2)
  bps                 Decimal               @db.Decimal(15, 2)
  roe                 Decimal               @db.Decimal(10, 2)
  ev                  BigInt
  name_en             String?               @db.VarChar(100)
  is_event            Boolean               @default(false)
  affinity            affinity[]
  alarms              alarms[]
  char_reactions      char_reactions[]
  characters          characters?
  event_activity      event_activity[]
  have_badges         have_badges[]
  holdings            holdings[]
  interest            interest[]
  orders              orders[]
  posts               posts[]
  stock_history       stock_history[]
  categories          categories?           @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  transaction_history transaction_history[]

  @@unique([code, exchange_code])
}

model storage {
  user_id      BigInt
  furniture_id BigInt
  quantity     Int        @db.SmallInt
  furnitures   furnitures @relation(fields: [furniture_id], references: [id], onUpdate: NoAction)
  users        users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, furniture_id])
}

model transaction_history {
  id                BigInt    @id @default(autoincrement())
  user_id           BigInt
  stock_id          BigInt
  trade_type        String    @db.VarChar(10)
  quantity          Int
  trade_price       BigInt
  transaction_time  DateTime? @default(now()) @db.Timestamp(6)
  avg_cost_at_trade BigInt?
  realized_profit   BigInt?
  stocks            stocks    @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                                                     BigInt                @id @default(autoincrement())
  login_id                                               String                @unique @db.VarChar(100)
  login_pw                                               String                @db.VarChar(255)
  nickname                                               String                @unique @db.VarChar(15)
  balance                                                BigInt                @default(100000000)
  profile_img_url                                        String?
  share_option                                           Boolean               @default(true)
  affinity                                               affinity[]
  alarms                                                 alarms[]
  char_affinity_char_affinity_character_1Tousers         char_affinity[]       @relation("char_affinity_character_1Tousers")
  char_affinity_char_affinity_character_2Tousers         char_affinity[]       @relation("char_affinity_character_2Tousers")
  char_affinity_log_char_affinity_log_character_1Tousers char_affinity_log[]   @relation("char_affinity_log_character_1Tousers")
  char_affinity_log_char_affinity_log_character_2Tousers char_affinity_log[]   @relation("char_affinity_log_character_2Tousers")
  char_reactions_char_reactions_reactor_idTousers        char_reactions[]      @relation("char_reactions_reactor_idTousers")
  char_reactions_char_reactions_receiver_idTousers       char_reactions[]      @relation("char_reactions_receiver_idTousers")
  comments                                               comments[]
  follow_follow_followee_idTousers                       follow[]              @relation("follow_followee_idTousers")
  follow_follow_follower_idTousers                       follow[]              @relation("follow_follower_idTousers")
  have_badges                                            have_badges[]
  have_tags                                              have_tags[]
  holdings                                               holdings[]
  interest                                               interest[]
  inventory                                              inventory[]
  like_posts                                             like_posts[]
  orders                                                 orders[]
  placed                                                 placed[]
  posts_posts_target_user_idTousers                      posts[]               @relation("posts_target_user_idTousers")
  posts_posts_writer_idTousers                           posts[]               @relation("posts_writer_idTousers")
  room_reactions_room_reactions_reactor_idTousers        room_reactions[]      @relation("room_reactions_reactor_idTousers")
  room_reactions_room_reactions_receiver_idTousers       room_reactions[]      @relation("room_reactions_receiver_idTousers")
  storage                                                storage[]
  transaction_history                                    transaction_history[]
  voting                                                 voting[]
  wardrobe                                               wardrobe[]
}

model vote {
  state        Boolean
  end_date     DateTime       @db.Date
  post_id      BigInt         @id
  posts        posts          @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vote_options vote_options[]
  voting       voting[]
}

model voting {
  vote_id   BigInt
  voter_id  BigInt
  option_no Int    @db.SmallInt
  vote      vote   @relation(fields: [vote_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction)
  users     users  @relation(fields: [voter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([vote_id, voter_id])
}

model wardrobe {
  user_id    BigInt
  clothes_id BigInt
  clothes    clothes @relation(fields: [clothes_id], references: [id], onUpdate: NoAction)
  users      users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, clothes_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alarms {
  user_id  BigInt
  stock_id BigInt
  price    BigInt
  stocks   stocks @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, stock_id, price])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model badges {
  id          BigInt        @id @default(autoincrement())
  unlock      String        @db.VarChar(100)
  have_badges have_badges[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model char_affinity {
  character_1                            BigInt
  character_2                            BigInt
  affinity_score                         Int    @db.SmallInt
  users_char_affinity_character_1Tousers users  @relation("char_affinity_character_1Tousers", fields: [character_1], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_char_affinity_character_2Tousers users  @relation("char_affinity_character_2Tousers", fields: [character_2], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([character_1, character_2])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model char_affinity_log {
  id                                         BigInt   @id @default(autoincrement())
  character_1                                BigInt
  character_2                                BigInt
  happening                                  String   @db.VarChar(300)
  change_rate                                Decimal  @db.Decimal(6, 2)
  create_at                                  DateTime @db.Timestamp(6)
  users_char_affinity_log_character_1Tousers users    @relation("char_affinity_log_character_1Tousers", fields: [character_1], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_char_affinity_log_character_2Tousers users    @relation("char_affinity_log_character_2Tousers", fields: [character_2], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model char_reactions {
  reactor_id                              BigInt
  receiver_id                             BigInt
  stock_id                                BigInt
  reaction_id                             BigInt
  reactions                               reactions @relation(fields: [reaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_char_reactions_reactor_idTousers  users     @relation("char_reactions_reactor_idTousers", fields: [reactor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_char_reactions_receiver_idTousers users     @relation("char_reactions_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stocks                                  stocks    @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([reactor_id, receiver_id, stock_id, reaction_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model event_activity {
  stock_id     BigInt
  emotion_type String @db.VarChar(50)
  act          String @db.VarChar(100)
  stocks       stocks @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([stock_id, emotion_type])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model follow {
  follower_id                     BigInt
  followee_id                     BigInt
  users_follow_followee_idTousers users  @relation("follow_followee_idTousers", fields: [followee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_follow_follower_idTousers users  @relation("follow_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([follower_id, followee_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model have_badges {
  user_id   BigInt
  stock_id  BigInt
  badge_id  BigInt
  is_hidden Boolean
  badges    badges  @relation(fields: [badge_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stocks    stocks  @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, stock_id, badge_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model have_tags {
  user_id BigInt
  tag_id  BigInt
  self    Boolean
  tags    tags    @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, tag_id, self])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model orders {
  id        BigInt   @id @default(autoincrement())
  user_id   BigInt
  stock_id  BigInt
  type      String   @db.VarChar(10)
  quantity  Int      @db.SmallInt
  create_at DateTime @default(now()) @db.Timestamp(6)
  side      String?
  price     BigInt?
  status    String?  @default("PENDING") @db.VarChar(15)
  stocks    stocks   @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reactions {
  id             BigInt           @id @default(autoincrement())
  img            String           @db.VarChar(200)
  char_reactions char_reactions[]
  room_reactions room_reactions[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model room_reactions {
  reactor_id                              BigInt
  receiver_id                             BigInt
  reaction_id                             BigInt
  reactions                               reactions @relation(fields: [reaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_room_reactions_reactor_idTousers  users     @relation("room_reactions_reactor_idTousers", fields: [reactor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_room_reactions_receiver_idTousers users     @relation("room_reactions_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([reactor_id, receiver_id, reaction_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tags {
  id        BigInt      @id @default(autoincrement())
  content   String      @db.VarChar(100)
  have_tags have_tags[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vote_options {
  vote_id   BigInt
  option_no Int    @db.SmallInt
  content   String @db.VarChar(500)
  vote      vote   @relation(fields: [vote_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([vote_id, option_no])
}
